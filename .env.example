# Copy to .env.local. Dev always runs on the local Supabase: values from `supabase status -o env`.
# Production values live only in Vercel; never point this file at the production project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54821
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMS (login do cliente por telefone). SMS_PROVIDER=comtele em produção, log em dev.
SMS_PROVIDER=log
COMTELE_API_KEY=
COMTELE_ROUTE=17
SEND_SMS_HOOK_SECRET=v1,whsec_...

# E-mail (link de redefinir senha). EMAIL_PROVIDER=resend em produção, log em dev (imprime o link no terminal).
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Komyx <nao-responda@komyx.com.br>
EMAIL_REPLY_TO=contato@komyx.com.br
# Local: o valor de [auth.hook.send_email] secrets em supabase/config.toml.
SEND_EMAIL_HOOK_SECRET=v1,whsec_...
# Avisos por e-mail (pedido de orçamento, reserva online, contrato aceito, pedido do cliente).
# O Postgres chama /api/notifications/email com "Authorization: Bearer <segredo>". Em dev pode ficar
# vazio (usa o segredo local da migration 20261017120000); em produção é obrigatório e igual ao
# segredo `notify_email_secret` do Vault do Supabase.
NOTIFY_EMAIL_SECRET=

# WhatsApp do suporte Komyx (Minha conta → alterar forma de pagamento / cancelar). Só dígitos com DDD.
NEXT_PUBLIC_SUPPORT_WHATSAPP=5511999999999

# Komyx monthly fees (Asaas). Leave ASAAS_API_KEY empty to bill by hand in /admin/cobranca.
# ASAAS_ENV: "sandbox" (default) or "production". ASAAS_WEBHOOK_TOKEN: the token set on the Asaas
# webhook pointing to https://www.komyx.com.br/api/billing/asaas
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
