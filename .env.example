# Copy to .env.local. Values below come from `supabase status -o env` for local dev.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54821
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMS (login do cliente por telefone). SMS_PROVIDER=comtele em produção, log em dev.
SMS_PROVIDER=log
COMTELE_API_KEY=
COMTELE_ROUTE=17
SEND_SMS_HOOK_SECRET=v1,whsec_...

# WhatsApp do suporte Festeja (Minha conta → alterar forma de pagamento / cancelar). Só dígitos com DDD.
NEXT_PUBLIC_SUPPORT_WHATSAPP=5511999999999
