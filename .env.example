# Copie para .env.local e preencha. Nada aqui é segredo de verdade — é a lista
# do que o app precisa para subir, com o que cada coisa faz.

# --- Supabase ---------------------------------------------------------------
# Painel do projeto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: passa por cima de RLS. Usada só pelo webhook do Stripe, que
# chega sem sessão de usuário. NUNCA prefixar com NEXT_PUBLIC_ — isso mandaria
# a chave para o navegador de todo mundo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -----------------------------------------------------------------
# Sem estas três, o app funciona e o portão de fim de teste NÃO fecha: ninguém
# fica trancado numa tela cujo botão de pagar não existe.
#
# Onde pegar cada uma:
#   STRIPE_SECRET_KEY    Developers → API keys → Secret key (sk_test_… / sk_live_…)
#   STRIPE_PRICE_ID      Product catalog → o preço recorrente de R$ 19,90/mês (price_…)
#   STRIPE_WEBHOOK_SECRET  Developers → Webhooks → o endpoint /api/stripe/webhook (whsec_…)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Endereço público -------------------------------------------------------
# Para onde o Stripe devolve o corretor depois do checkout. Precisa ser o
# domínio onde ele tem sessão: a URL da Vercel não serve em produção.
NEXT_PUBLIC_SITE_URL=https://www.komyx.com.br
