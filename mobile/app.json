{
  "expo": {
    "name": "Komyx",
    "slug": "komyx",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "komyx",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aralabs.komyx",
      "associatedDomains": [
        "applinks:komyx.com.br",
        "applinks:www.komyx.com.br"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.aralabs.komyx",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#faf7f2"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "komyx.com.br",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "komyx.com.br",
              "pathPrefix": "/g/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#1b1f3a",
          "dark": {
            "backgroundColor": "#1b1f3a"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Komyx usa suas fotos para a arte do convite da festa.",
          "cameraPermission": "O Komyx usa a câmera para tirar a foto da arte do convite da festa.",
          "microphonePermission": "O Komyx usa o microfone ao gravar vídeos para o convite da festa."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12809420-94c7-4b3e-934b-6196405d909a"
      }
    },
    "owner": "thiagodevtavares",
    "updates": {
      "url": "https://u.expo.dev/12809420-94c7-4b3e-934b-6196405d909a"
    },
    "locales": {
      "pt-BR": "./locales/pt-BR.json"
    }
  }
}
