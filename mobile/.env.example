# Komyx app em dev · Supabase local e site local pelo IP da máquina na rede (ipconfig getifaddr en0),
# para funcionar também num celular de verdade. Chave: `supabase status -o env` (PUBLISHABLE_KEY).
EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:54821
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
# Site, usado nos links abertos dentro do app (página da festa, PDFs, contrato, editor do convite)
EXPO_PUBLIC_WEB_URL=http://192.168.x.x:3000
